class Quartermaster < Formula
  desc "Picks the model and effort for each Claude Code worker and reviewer"
  homepage "https://github.com/IZZY-Agency/quartermaster"
  license "MIT"

  livecheck do
    url :stable
    strategy :github_latest
  end

  on_macos do
    on_arm do
      url "https://github.com/IZZY-Agency/quartermaster/releases/download/v{{VERSION}}/quartermaster-{{VERSION}}-macos-arm64.tar.gz"
      sha256 "{{SHA_MACOS_ARM64}}"
    end
    on_intel do
      url "https://github.com/IZZY-Agency/quartermaster/releases/download/v{{VERSION}}/quartermaster-{{VERSION}}-macos-x86_64.tar.gz"
      sha256 "{{SHA_MACOS_X86_64}}"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/IZZY-Agency/quartermaster/releases/download/v{{VERSION}}/quartermaster-{{VERSION}}-linux-arm64.tar.gz"
      sha256 "{{SHA_LINUX_ARM64}}"
    end
    on_intel do
      url "https://github.com/IZZY-Agency/quartermaster/releases/download/v{{VERSION}}/quartermaster-{{VERSION}}-linux-x86_64.tar.gz"
      sha256 "{{SHA_LINUX_X86_64}}"
    end
  end

  def install
    bin.install "qm"
    bin.install "qm-privcheck" if OS.mac?
    pkgshare.install "share/quartermaster/plugins"
  end

  def caveats
    <<~EOS
      Run qm init to set quartermaster up.
    EOS
  end

  test do
    assert_match "qm #{version} (", shell_output("#{bin}/qm --version")
  end
end
